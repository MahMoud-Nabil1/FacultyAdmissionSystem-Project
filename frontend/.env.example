# The base URL pointing to the deployed backend server API
# In local development: http://localhost:5000/api
# In production on Render: https://faculty-admission-api.onrender.com/api
REACT_APP_API_BASE_URL=http://localhost:5000/api

# Groq API key for the AI chat assistant
# Get yours at https://console.groq.com
REACT_APP_GROQ_API_KEY=your_groq_api_key_here
